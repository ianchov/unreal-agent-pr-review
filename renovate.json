{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "GitHub Actions in the workflows: wait 3 days after a release, then Renovate merges minor, patch and digest updates once Install check passes.",
      "matchManagers": [
        "github-actions"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
